        { "path": ["quote", "-"], "value": { "id": "bindtoparent-local-1.1", "title": "BindToParent — 保存済み Elecbyte 1.1 公式資料", "url": "/MUGEN/document/Official/1.1b1/sctrls.html#bindtoparent", "source_type": "official_document" } },
