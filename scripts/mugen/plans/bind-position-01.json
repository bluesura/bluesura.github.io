        {
          "path": ["documentation"],
          "value": {
            "description": "<p>Helper である実行者を、親の軸を基準とする位置へ固定します。実行者が Helper でない場合は何も起きません。親が破棄されると固定は終了します。</p>",
            "evidence": { "status": "confirmed", "basis": ["official_document"], "source_refs": ["bindtoparent-local-2002", "bindtoparent-local-1.0", "bindtoparent-local-1.1"] }
          }
        },
