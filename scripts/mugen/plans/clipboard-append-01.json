            0,
            "documentation"
          ],
          "value": {
            "value": [
              "表示する書式文字列"
            ],
            "description": "<p>表示する文字列をダブルクォートで囲んで指定します。<code>%d</code> は整数、<code>%f</code> は浮動小数点数を <code>Params</code> から差し込み、<code>%%</code> は % 自体を表示します。改行には <code>&#92;n</code>、タブには <code>&#92;t</code> を使えます。MUGEN 1.0 / 1.1 では数値の書式指定として <code>%d</code>、<code>%i</code>、<code>%f</code>、<code>%F</code>、<code>%e</code>、<code>%E</code>、<code>%g</code>、<code>%G</code> が記載されています。</p>",
            "hide_legacy": [
              "default_value",
              "possible_value"
            ],
            "evidence": {
              "status": "confirmed",
              "basis": [
                "official_document"
              ],
