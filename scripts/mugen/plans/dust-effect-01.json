        { "path": ["parameter", 0, "documentation"], "value": { "value": ["表示間隔"], "description": "<p>土煙を何 tick ごとに表示するかを整数式で指定します。省略時は <code>3</code>、指定値は1以上です。</p>", "evidence": { "status": "confirmed", "basis": ["official_document"], "source_refs": ["makedust-local-2002", "makedust-local-1.0", "makedust-local-1.1"] } } },
