        { "path": ["quote", "-"], "value": { "id": "fallenvshake-local-1.1", "title": "FallEnvShake — 保存済み Elecbyte 1.1 公式資料", "url": "/MUGEN/document/Official/1.1b1/sctrls.html#fallenvshake", "source_type": "official_document" } },
        { "path": ["quote", "-"], "value": { "id": "fallenvshake-history-2000", "title": "FallEnvShake — 保存済み Elecbyte 更新履歴（2000-11-18）", "url": "/MUGEN/document/Official/2002.04.14/updates.txt", "source_type": "official_history" } },
