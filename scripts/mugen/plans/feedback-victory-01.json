              "enabled = 1"
            ]
          }
        },
        {
          "path": [
            "code_sample",
            "-"
          ],
          "value": {
            "title": "日本語を選ぶ（mugen.cfg）",
            "description": "<p>[ja.Quotes]と対応フォントを用意したうえで、[Config]の言語設定を指定します。キャラクターのCNSへ書く設定ではありません。</p>",
            "code": [
              "[Config]",
              "Language = \"ja\""
            ]
          }
        },
        {
          "path": [
            "code_sample",
            "-"
          ],
          "value": {
            "title": "相手の名前に合わせてvictory3を選ぶ",
            "description": "<p>既存の勝利ステートで使う例です。試合の勝者・本体から、存在する相手の内部名を比較します。表示する言語グループにvictory3を定義しておいてください。番号3は配列の3番目という説明ではなく、victory3の番号です。</p>",
            "code": [
              "[State 180, Victory quote]",
              "Type = VictoryQuote",
              "TriggerAll = !IsHelper",
              "TriggerAll = Win",
              "TriggerAll = NumEnemy > 0",
              "Trigger1 = P2Name = \"Kung Fu Man\"",
              "Value = 3"
            ]
          }
        },
