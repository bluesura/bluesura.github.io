            {
              "kind": "version_change",
              "content": "<p>Startとボタンを組み合わせてもパレット7〜12を選択できない不具合を、MUGEN 1.0 RC3で修正しました。</p>",
              "environment": {
                "engine": "mugen",
                "runtime": [
                  "mugen-1.0-rc3"
                ]
              },
              "evidence": {
                "status": "confirmed",
