              }
            },
            {
              "kind": "research",
              "content": "<p>1.0/1.1公式GameWidthのFormat欄はGameHeightになっています。実際の項目名・既存構文GameWidthを維持し、書式の転記差を内部へ残します。</p>",
              "environment": {
                "engine": "mugen"
              },
              "evidence": {
                "status": "conflicting",
                "basis": [
