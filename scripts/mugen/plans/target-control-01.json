    {
      "collection": "state-controllers",
      "name": "TargetDrop",
      "additions": [
        { "path": ["page", "engine"], "value": "mugen" },
        { "path": ["page", "introduced_in"], "value": null },
        { "path": ["documentation"], "value": { "description": "<p>実行者のターゲット一覧から対象を外します。<code>ExcludeID</code> と <code>KeepOne</code> を使い、指定 ID のターゲットを残せます。</p>", "evidence": { "status": "confirmed", "basis": ["official_document"], "source_refs": ["targetdrop-local-2002", "targetdrop-local-1.0", "targetdrop-local-1.1"] } } },
        { "path": ["parameter", 0, "expression_policy"], "value": "expression" },
        { "path": ["parameter", 0, "default"], "value": [{ "kind": "literal", "value": -1, "display": "すべてのターゲットを外す", "evidence": { "status": "confirmed", "basis": ["official_document"], "source_refs": ["targetdrop-local-2002", "targetdrop-local-1.0", "targetdrop-local-1.1"] } }] },
        { "path": ["parameter", 0, "documentation"], "value": { "description": "<p>一覧に残すターゲット ID を整数式で指定します。この ID と一致しないターゲットは一覧から外れます。省略時は <code>-1</code> で、すべてのターゲットを外します。</p>", "evidence": { "status": "confirmed", "basis": ["official_document"], "source_refs": ["targetdrop-local-2002", "targetdrop-local-1.0", "targetdrop-local-1.1"] } } },
        { "path": ["parameter", 0, "load_priority_evidence"], "value": { "status": "confirmed", "basis": ["maintainer_report"], "comment": "既存の読み込み順は基本的に検証済みとの管理者確認（2026-09-07）。検証ビルド等の詳細は未記録。" } },
        { "path": ["parameter", 1, "expression_policy"], "value": "expression" },
        { "path": ["parameter", 1, "default"], "value": [{ "kind": "literal", "value": 1, "display": "最大1体を残す", "evidence": { "status": "confirmed", "basis": ["official_document"], "source_refs": ["targetdrop-local-2002", "targetdrop-local-1.0", "targetdrop-local-1.1"] } }] },
        { "path": ["parameter", 1, "documentation"], "value": { "description": "<p>0以外なら、<code>ExcludeID</code> と一致する対象が複数いてもランダムに1体だけを残します。<code>0</code> なら、一致する対象をすべて残します。省略時は <code>1</code> です。</p>", "evidence": { "status": "confirmed", "basis": ["official_document"], "source_refs": ["targetdrop-local-2002", "targetdrop-local-1.0", "targetdrop-local-1.1"] } } },
        { "path": ["parameter", 1, "load_priority_evidence"], "value": { "status": "confirmed", "basis": ["maintainer_report"], "comment": "既存の読み込み順は基本的に検証済みとの管理者確認（2026-09-07）。検証ビルド等の詳細は未記録。" } },
        { "path": ["evidence"], "value": { "status": "confirmed", "basis": ["official_document"], "source_refs": ["targetdrop-local-2002", "targetdrop-local-1.0", "targetdrop-local-1.1"], "comment": "2026-09-30: 保存済み公式資料で一覧から外す動作、任意 ExcludeID / KeepOne と既定値を確認。" } },
        { "path": ["quote", "-"], "value": { "id": "targetdrop-local-2002", "title": "TargetDrop — 保存済み Elecbyte 2002.04.14 公式資料", "url": "/MUGEN/document/Official/2002.04.14/sctrls.html#TargetDrop", "source_type": "official_document" } },
        { "path": ["quote", "-"], "value": { "id": "targetdrop-local-1.0", "title": "TargetDrop — 保存済み Elecbyte 1.0 公式資料", "url": "/MUGEN/document/Official/1.0/sctrls.html#targetdrop", "source_type": "official_document" } },
        { "path": ["quote", "-"], "value": { "id": "targetdrop-local-1.1", "title": "TargetDrop — 保存済み Elecbyte 1.1 公式資料", "url": "/MUGEN/document/Official/1.1b1/sctrls.html#targetdrop", "source_type": "official_document" } },
        { "path": ["quote", "-"], "value": { "id": "targetdrop-legacy-data", "title": "TargetDrop — 移行前の説明原本", "url": "https://github.com/bluesura/bluesura.github.io/blob/0d581b7c5018eeeb63adf6803437490811703cb8/src/content/state-controllers/TargetDrop.json", "source_type": "source_code" } }
      ],
      "remaining": [{ "path": "page.introduced_in", "reason": "初導入ビルドは不明を保持する。" }]
