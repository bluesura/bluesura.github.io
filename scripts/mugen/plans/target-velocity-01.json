        { "path": ["parameter", 1, "documentation"], "value": { "description": "<p>各ターゲットの X 速度へ加算する量を浮動小数点式で指定します。正数はそのターゲットが向いている方向です。省略時は X 速度を変更しません。</p>", "evidence": { "status": "confirmed", "basis": ["official_document"], "source_refs": ["targetveladd-local-2002", "targetveladd-local-1.0", "targetveladd-local-1.1"] } } },
