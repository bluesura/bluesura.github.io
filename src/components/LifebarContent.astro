---
// src/components/LifebarContent.astro

export interface Props {
  content: any; // 複数のJSONスキーマに対応するためany型を使用
}

const { content } = Astro.props;

/** パラメータの型を日本語に変換するヘルパー関数 */
function formatType(type: string): string {
  switch (type) {
    case "boolean": return "0か1";
    case "int": return "整数";
    case "float": return "浮動小数点数";
    case "string": return "文字列";
    default: return type;
  }
}
---

<!-- 説明 -->
{content.description && <p class="description" itemprop="articleBody" set:html={content.description}></p>}

<!-- サンプルコード -->
{content.sample_code?.code?.length > 0 && (
  <section id="SampleCode">
    <div class="section">
      <h2>設定可能なパラメータ一覧</h2>
      <div class="code">
        <ul>
          {content.sample_code.code.map((line: string) => <li set:html={line}></li>)}
        </ul>
      </div>
    </div>
  </section>
)}

<!-- パラメータ詳細 -->
{content.parameter?.length > 0 && content.parameter[0].parameter && (
  <section id="Parameter">
    <div class="section">
      <h2>パラメーター</h2>
      {content.parameter.map((param: any) => (
        <dl class="parameter">
          <dt>
            <span class="main" id={param.parameter}>
              {param.main ? (
                <Fragment set:html={param.main} />
              ) : (
                `${param.parameter} = ${param.value.join(', ')}`
              )}
              ({param.type.map((type: string) => formatType(type)).join(', ')})
            </span>
          </dt>
          <dd>
            <div class="description" set:html={param.description}></div>
            <div class="option-value">
              {(param.min_value || param.max_value) && (
                <div class="range-value">
                  {param.min_value && <span class="min-value">最小値: {param.min_value}</span>}
                  {param.min_value && param.max_value && ','}
                  {param.max_value && <span class="max-value">最大値: {param.max_value}</span>}
                </div>
              )}
              {param.possible_value && <div class="possible-value">選択可能な文字列: {param.possible_value}</div>}
              {param.default_value === "required" && <div class="required-parameter">省略不可</div>}
              {param.default_value === "instead" && <div class="instead-parameter">代替書式</div>}
              {param.default_value && !["required", "instead"].includes(param.default_value) && (
                <div class="default-value">省略時のデフォルト値： {param.default_value}</div>
              )}
            </div>
            {param.media && (
              <div class="media">
                {param.media.video?.length > 0 && (
                  <div class="video-group">
                    {param.media.video.map((video: any) => (
                      <div class="video">
                        <div class="title">{video.title}</div>
                        <video controls>
                          <source src={`/MUGEN/document/Lifebar/video/${video.file}.mp4`} type="video/mp4" />
                          <source src={`/MUGEN/document/Lifebar/video/${video.file}.webm`} type="video/webm" />
                          <source src={`/MUGEN/document/Lifebar/video/${video.file}.ogg`} type="video/ogg" />
                          <a href={`/MUGEN/document/Lifebar/video/${video.file}.mp4`}>動画</a>
                        </video>
                      </div>
                    ))}
                  </div>
                )}
                {param.media.image?.length > 0 && (
                  <div class="image-group">
                    {param.media.image.map((image: any) => (
                      <div class="image">
                        <div class="title">{image.title}</div>
                        <div class="image-frame">
                          <img src={`/MUGEN/document/Lifebar/img/${image.file}`} alt={image.title} width={image.width} height={image.height} />
                        </div>
                      </div>
                    ))}
                  </div>
                )}
              </div>
            )}
          </dd>
        </dl>
      ))}
    </div>
  </section>
)}

<!-- htmコンテンツ (BeginAction.jsonなどで使用) -->
{content.htm && <Fragment set:html={content.htm} />}

<!-- 引用記事 -->
{content.quote?.length > 0 && content.quote[0].title?.trim() !== '-' && (
  <section id="Quote">
    <div class="section">
      <h2>引用記事</h2>
      <ul>
        {content.quote.map((quote: any) => (
          <li><a href={quote.url} target="_blank" rel="noopener noreferrer">{quote.title}</a></li>
        ))}
      </ul>
    </div>
  </section>
)}

<!-- {include file="./nav.tpl"} はAstroの<Navigation />コンポーネントなどに置き換える想定 -->