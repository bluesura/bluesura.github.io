    <ins class="adsbygoogle"
         style="display:block"
         data-ad-format="fluid"
         data-ad-layout-key="-89+1m-dq+ei+hz"
         data-ad-client="ca-pub-9960110085246197"
         data-ad-slot="1427349786"></ins>
    <script is:inline>
      (adsbygoogle = window.adsbygoogle || []).push({});
    </script>
  </div>

  <div id="box2">
    <div class="article-survey-container">
      <div class="toc" id="toc">
        <div class="title">目次</div>
        <ul><!-- ここに目次が動的に挿入されます --></ul>
      </div>
    </div>
    <script>
    // === 目次自動生成スクリプト（ランダムID版） ===
    document.addEventListener("DOMContentLoaded", () => {
      // --- 設定 ---
      const config = {
        tocContainer: "#toc ul",
        contentSource: "#main-inner",
        headings: ["h2", "h3", "dt"]
      };

      const tocList = document.querySelector(config.tocContainer);
      const contentSource = document.querySelector(config.contentSource);

      if (!tocList || !contentSource) {
        console.warn("目次生成に必要な要素が見つかりませんでした。");
        return;
      }

      // 一意なランダムIDを生成する関数
      const generateRandomId = () => {
        // プレフィックスを付けて、他のIDと衝突する可能性をさらに低減
        return 'toc-id-' + Math.random().toString(36).slice(2, 11);
      };

      const fragment = document.createDocumentFragment();
      let lastH2ListItem = null;

      const headings = contentSource.querySelectorAll(config.headings.join(","));

      headings.forEach(heading => {
        const level = parseInt(heading.tagName.slice(1)) || 3;
        const baseLevel = parseInt(config.headings[0].slice(1));

        // 1. 見出しにIDを付与
        // 既存のIDがあればそれを使い、なければランダムなIDを生成する
        let id = heading.id || generateRandomId();
        heading.id = id;

        // 2. 目次のリスト項目(li)とリンク(a)を作成
        const listItem = document.createElement("li");
        const link = document.createElement("a");
        link.href = `#${id}`;
        link.textContent = heading.textContent.trim();
        listItem.style="white-space: nowrap;overflow: hidden;text-overflow: ellipsis;";
        listItem.appendChild(link);

        // 3. 階層構造を考慮して目次に追加
        if (level === baseLevel) { // h2の場合
          fragment.appendChild(listItem);
          lastH2ListItem = listItem;
        } else if (level > baseLevel && lastH2ListItem) { // h3で、直前にh2がある場合
          let sublist = lastH2ListItem.querySelector("ul");
          if (!sublist) {
            sublist = document.createElement("ul");
            lastH2ListItem.appendChild(sublist);
          }
          sublist.appendChild(listItem);
        }
      });

      tocList.replaceChildren(fragment);
    });
    </script>
  </div>

  <div id="box2">
    <div class="article-survey-container">
      <div class="menu">
        <!-- ステートコントローラーのメニュー -->
        <label for="menu_bar01">+ ステートコントローラー 一覧を見る</label>
        <input type="checkbox" id="menu_bar01" class="accordion" />
        <ul id="links01">
          <li><a href="/MUGEN/document/State/">Top Page</a></li>
          {stateControllers.map(item => (
            <li>
              <a href={`/MUGEN/document/State/${item.id}.html`}>{item.data.state}</a>
            </li>
          ))}
        </ul>

        <!-- トリガーのメニュー -->
        <label for="menu_bar02">+ トリガー 一覧を見る</label>
        <input type="checkbox" id="menu_bar02" class="accordion" />
        <ul id="links02">
          <li><a href="/MUGEN/document/Trigger/">Top Page</a></li>
          {triggers.map(item => (
            <li>
              <a href={`/MUGEN/document/Trigger/${item.id}.html`}>{item.data.trigger}</a>
            </li>
          ))}
        </ul>

        <!-- ライフバーのメニュー -->
        <label for="menu_bar03">+ ライフバーの設定 を見る</label>
        <input type="checkbox" id="menu_bar03" class="accordion" />
        <ul id="links03">
          <li><a href="/MUGEN/document/Lifebar/">Top Page</a></li>
          {lifebars.map(item => {
            // item.idから拡張子(.json)を取り除いてURLを生成する
            const slug = item.id.replace(/\.json$/, '');
            const title = item.data.group || slug;
            return <li><a href={`/MUGEN/document/Lifebar/${slug}.html`}>{title}</a></li>
          })}
        </ul>
      </div>
    </div>
