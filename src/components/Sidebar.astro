---
// src/components/Sidebar.astro

import { getCollection } from 'astro:content';

// 'state-controllers' コレクションから全てのデータを取得
const stateControllers = await getCollection('state-controllers');
stateControllers.sort((a, b) => a.data.state.localeCompare(b.data.state));

const triggers = await getCollection('triggers');
triggers.sort((a, b) => a.data.trigger.localeCompare(b.data.trigger));

const lifebars = await getCollection('lifebars');
// groupプロパティでソート（オプション）
lifebars.sort((a, b) => (a.data.group || a.id).localeCompare(b.data.group || b.id));
---
<div id="sidebar">
  <div id="box2" style="padding:0;width:324px;height:100%;">
