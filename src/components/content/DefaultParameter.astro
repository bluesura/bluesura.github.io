---
import { copyLines } from '../../lib/mugen/defaults.mjs';
const { content } = Astro.props;
const lines = copyLines(content, content.parameter ?? []);
---
<section id="DefaultParameter">
  <div class="section">
    <h2>コピペ用パラメーター一覧（省略時の挙動）</h2>
    <div class="code" contenteditable="true" aria-label="コピペ用パラメーター一覧"><ul>
      {lines.map(line => <li>{line}</li>)}
      {content.default_parameter && <>
        {content.default_parameter.required_parameter?.map(line => <li class="required-parameter" set:html={line} />)}
        {content.default_parameter.instead_parameter?.map(line => <li class="instead-parameter" set:html={line} />)}
        {content.default_parameter.optional_parameter?.map(line => <li class="optional-parameter" set:html={line} />)}
      </>}
    </ul></div>
  </div>
</section>
<hr>
