---
export interface Props {
  content: {
    category: string;
    state?: string;
    parameter?: {
      parameter: string;
      parameter_type: string;
      default_value: string[];
    }[];
    default_parameter?: {
      required_parameter?: string[];
      instead_parameter?: string[];
      optional_parameter?: string[];
    };
  };
}

const { content } = Astro.props;

// パラメータ名の長さに応じてスペースを追加するヘルパー関数
function formatParam(param: string, maxLength = 27): string {
  const spaces = ' '.repeat(Math.max(0, maxLength - param.length));
  return `${param}${spaces}`;
}
---
<section id="DefaultParameter">
  <div class="section">
    <h2>省略した時のデフォルト値</h2>
    <div class="code" contenteditable="true">
      <ul>
        {content.category === "state" && (
          <>
            <li>[State ,{content.state}]</li>
            <li>Type                       = {content.state}</li>
            <li>Trigger1                   = 1</li>
          </>
        )}
        {content.category === "statetype" && (
          <li>[StateDef 『正の整数』]</li>
        )}

        {/* 新しいパラメータ形式 (parameter配列が存在する場合) */}
		{content.parameter && content.parameter.some(p => p.parameter_type) && (
		  content.parameter.map(param => (
			<li class={`${param.parameter_type}-parameter`}>
			  {formatParam(param.parameter)}= {/* ★★★ ここから修正 ★★★ */}
			  {param.default_value && Array.isArray(param.default_value)
				? param.default_value.join(', ')
				: '(必須項目)'} {/* default_value がない場合は '(必須項目)' と表示する例 */}
			</li>
		  ))
		)}
        
        {/* 古いパラメータ形式 (default_parameterオブジェクトが存在する場合) */}
        {content.default_parameter && (
          <>
            {content.default_parameter.required_parameter?.map(param => (
              <li class="required-parameter" set:html={param}></li>
            ))}
            {content.default_parameter.instead_parameter?.map(param => (
              <li class="instead-parameter" set:html={param}></li>
            ))}
            {content.default_parameter.optional_parameter?.map(param => (
              <li class="optional-parameter" set:html={param}></li>
            ))}
          </>
        )}
      </ul>
    </div>
  </div>
</section>
<hr>