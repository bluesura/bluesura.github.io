---
export interface Props {
  parameter?: { parameter: string; load_priority?: string[] }[];
}
const { parameter = [] } = Astro.props;
---
<section id="LoadParameter">
  <div class="section">
    <h2>パラメーターの読み込み順</h2>
    {parameter.length > 0 && <div class="load-order-table">
      <table>
        <thead><tr><th scope="col">パラメーター</th><th scope="col">読み込み順</th></tr></thead>
        <tbody>{parameter.map(param => <tr>
          <th scope="row"><code>{param.parameter}</code></th>
          <td><code>{(param.load_priority ?? ['?']).join(', ')}</code></td>
        </tr>)}</tbody>
      </table>
    </div>}
    <p class="supplement">*バージョンや実行環境、パラメーターの指定の仕方によって、読み込まれる順番が変わる可能性があります。<code>?</code> は読み込み順が不明な項目です。</p>
  </div>
</section>
<hr>
