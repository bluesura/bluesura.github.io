---
import Evidence from './Evidence.astro';
export interface Props {
  parameter?: {
    parameter: string;
    load_priority?: string[];
    load_priority_evidence?: Record<string, unknown>;
  }[];
}
const { parameter } = Astro.props;
---
<section id="LoadParameter">
  <div class="section">
    <h2>パラメーターの読み込み順</h2>
    
    {parameter && parameter.length > 0 && (
      <div>
        <p>
          {parameter.map((param, index) => (
            <>
              {param.parameter}({(param.load_priority ?? ['?']).join(', ')})
              {index < parameter.length - 1 ? ' => ' : ''}
            </>
          ))}
        </p>
        {parameter.filter(param => param.load_priority_evidence).map(param => <div>
          <strong>{param.parameter}</strong><Evidence evidence={param.load_priority_evidence} />
        </div>)}
      </div>
    )}

    <div class="supplement">
      <br/>*バージョンや実行環境,パラーメータの指定の仕方によって、読み込まれる順番が変わる可能性があります。参考程度なものだと思ってください。
    </div>
  </div>
</section>
<hr>
