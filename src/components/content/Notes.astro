---
import registry from '../../data/engine-versions.json';
import { versionLabel, environmentLabel } from '../../lib/mugen/versions.mjs';
import { isPublicNote } from '../../lib/mugen/normalize.mjs';
const { notes = [] } = Astro.props;
const visible = notes.filter(isPublicNote);
const labels = { behavior: '仕様', version_change: '変更履歴', bug: 'バグ', warning: '警告', error: 'エラー', compatibility: '互換性', undocumented: '未文書化', deprecated: '非推奨', limitation: '制約' };
const changes = { added: '追加', changed: '変更', fixed: '修正', removed: '削除', deprecated: '非推奨化' };
---
{visible.length > 0 && <ul class="specification-notes">
  {visible.map(note => <li class="specification-note" data-note-kind={note.kind}>
    <div class="note-heading">
      <span class="note-kind">{note.kind ? labels[note.kind] : note.legacy?.no}</span>
      {note.change && <span>{changes[note.change]}</span>}
      {note.at && <span>{versionLabel(note.at, registry)}</span>}
      {note.environment && <span>{environmentLabel(note.environment, registry)}</span>}
      {note.kind && note.legacy?.no && !['-', labels[note.kind], '警告文'].includes(note.legacy.no) && <span class="note-legacy-label">{note.legacy.no}</span>}
    </div>
    <div class="note-body">
      {note.message && <p><code>{note.message}</code></p>}
      {note.condition && <p>{note.condition}</p>}
      {note.legacy?.blockquote ? <blockquote cite={note.legacy.blockquote} set:html={note.content} /> : <Fragment set:html={note.content} />}
    </div>
  </li>)}
</ul>}
