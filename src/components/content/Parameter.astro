---
// src/components/content/Parameter.astro (メディア表示機能を追加)
import { Image } from 'astro:assets';

// このコンポーネントが受け取るプロパティの型定義
export interface Props {
  parameter?: any[];
}
const { parameter } = Astro.props;

// パラメータの型を日本語に変換するヘルパー関数
function formatType(type: string): string {
  switch (type) {
    case "boolean": return "0か1";
    case "int": return "整数";
    case "float": return "浮動小数点数";
    case "string": return "文字列";
    default: return type;
  }
}
---
<section id="Parameter">
  <div class="section">
    <h2>パラメーター</h2>
    {/* パラメータが存在しない場合の表示 */}
    {(!parameter || parameter.length === 0 || parameter[0].parameter === "") ? (
      <div>なし</div>
      <hr>
    ) : (
      // 各パラメータをループ処理して表示
      parameter.map(param => (
        <dl class="parameter">
          <dt class="main">
            {param.parameter}
            {/* ★★★ ここから修正 ★★★ */}
            {/* param.value が存在し、かつ空の配列でない場合のみ「= 値」を出力する */}
            {param.value && param.value.length > 0 && param.value[0] !== "" && (
              ` = ${param.value.join(', ')}`
            )}
            {/* ★★★ 修正ここまで ★★★ */}
            ({param.type.map(formatType).join(', ')})
          </dt>
          <dd>
            <div class="description" set:html={param.description}></div>
            <div class="option-value">
              {/* --- ここからメディアセクション --- */}
              {param.media && (
                <div class="media">
                  {/* YouTube動画 */}
                  {param.media.youtube?.length > 0 && (
                    <div class="video-group">
                      {param.media.youtube.map((youtube: any) => (
                        <div>
                          <div>{youtube.title}</div>
                          <div style="position: relative; padding-bottom: 56.25%; padding-top: 25px; height: 0;">
                            <iframe 
                              style="position: absolute; top: 0; left: 0; width: 100%; height: 100%;" 
                              src={`https://www.youtube.com/embed/${youtube.file}`} 
                              frameborder="0" 
                              allowfullscreen
                            ></iframe>
                          </div>
                        </div>
                      ))}
                    </div>
                  )}

                  {/* ローカルビデオ */}
                  {param.media.video?.length > 0 && (
                    <div class="video-group">
                      {param.media.video.map((video: any) => (
                        <div class="video image-frame">
                          <div class="title">
                            {/* パスはpublicディレクトリからの絶対パスに修正 */}
                            <a href={`/videos/State/${video.file}.mp4`}>{video.title}</a>
                          </div>
                          <video controls>
                            <source src={`/videos/State/${video.file}.mp4`} type="video/mp4" />
                          </video>
                        </div>
                      ))}
                    </div>
                  )}

                  {/* ローカル画像 */}
                  {param.media.image?.length > 0 && (
                    <div class="image-group">
                      {param.media.image.map((image: any) => (
                        <div class="image">
                          <div>{image.title}</div>
                          <div class="image-frame">
                            {/* パスはpublicディレクトリからの絶対パスに修正 */}
                            <img 
                              src={`/images/State/${image.file}`} 
                              alt={image.title} 
                              width={image.width} 
                              height={image.height} 
                            />
                          </div>
                        </div>
                      ))}
                    </div>
                  )}
                </div>
              )}
              {/* --- メディアセクションここまで --- */}
              {param.possible_value && Array.isArray(param.possible_value[0]) ? (
                <div class="possible-value">
                  <table>
                    <tr>
                      <th set:html={param.possible_value[0][0]}></th>
                      <th set:html={param.possible_value[0][1]}></th>
                    </tr>
                    {param.possible_value.slice(1).map(row => (
                      <tr>
                        <td set:html={row[0]}></td>
                        <td set:html={row[1]}></td>
                      </tr>
                    ))}
                  </table>
                </div>
              ) : param.possible_value && (
                <div class="possible-value">
                  選択可能な文字列: {param.possible_value.join(', ')}
                </div>
              )}

              {(param.min_value?.filter(Boolean).length > 0 || param.max_value?.filter(Boolean).length > 0) && (
                <div class="range-value">
                {/* 最小値を表示する際も、空の値を除外してからjoinする */}
                {param.min_value?.filter(Boolean).length > 0 && (
                  <span class="min-value">
                    最小値: {param.min_value.filter(Boolean).join(', ')}
                  </span>
                )}
                
                {/* 両方に有効な値がある場合のみカンマを表示 */}
                {param.min_value?.filter(Boolean).length > 0 && param.max_value?.filter(Boolean).length > 0 && ','}
                
                {/* 最大値を表示する際も、空の値を除外してからjoinする */}
                {param.max_value?.filter(Boolean).length > 0 && (
                  <span class="max-value">
                    最大値: {param.max_value.filter(Boolean).join(', ')}
                  </span>
                )}
                </div>
              )}
              
              {param.parameter_type === "required" && <div class="required-parameter">省略不可</div>}
              {param.parameter_type === "instead" && <div class="instead-parameter">代替書式</div>}
              {param.default_value && param.default_value[0] !== "" && <div class="default-value">省略時のデフォルト値： {param.default_value.join(', ')}</div>}
            </div>
          </dd>
        </dl>
        <hr>
      ))
    )}
  </div>
</section>