---
import Specification from './Specification.astro';
import registry from '../../data/engine-versions.json';
import { environmentLabel } from '../../lib/mugen/versions.mjs';
import { describeDefault } from '../../lib/mugen/defaults.mjs';
export interface Props { parameter?: any[]; collection: string; }
const { parameter = [], collection } = Astro.props;
const parameters = parameter.filter(param => param.parameter);
const policies = { expression: '式を指定可能', constant_only: '定数のみ', string_literal: '文字列・属性のリテラル', special_syntax: '専用構文' };
const types = { boolean: '0か1', int: '整数', float: '浮動小数点数', string: '文字列' };
const formatType = type => types[type.toLowerCase()] ?? type;
// Keep separate anchors even for legacy alternative forms with the same spelling.
const anchor = (param, index) => 'parameter-' + param.parameter.replace(/[^a-zA-Z0-9_.-]+/g, '-') + '-' + index;
---
<section id="Parameter">
  <div class="section">
    <h2>{collection === 'triggers' ? '引数' : 'パラメーター'}</h2>
    {parameters.length === 0 ? <p>なし</p> : <>
      {parameters.length > 5 && <details class="parameter-directory">
        <summary>パラメーター一覧 <span>{parameters.length}項目</span></summary>
        <ul>{parameters.map((param, index) => <li><a href={'#' + anchor(param, index)}>{param.parameter}</a></li>)}</ul>
      </details>}
      <div class="parameter-list">{parameters.map((param, index) => (
        <section class="parameter-entry" aria-labelledby={anchor(param, index)}>
          <div class="parameter-heading">
            <h3 id={anchor(param, index)}><code>{param.parameter}</code></h3>
            {param.parameter_type === 'required' && <span class="parameter-requirement">省略不可</span>}
            {param.parameter_type === 'instead' && <span class="parameter-requirement">代替書式</span>}
          </div>
          {param.value?.filter(Boolean).length > 0 && <p class="parameter-purpose">{param.value.join(', ')}</p>}
          <div class="parameter-meta">
            {param.type?.length > 0 && <div><span class="meta-label">型</span><span>{param.type.map(formatType).join(', ')}</span></div>}
            {policies[param.expression_policy] && <div><span class="meta-label">指定</span><span>{policies[param.expression_policy]}</span></div>}
            {describeDefault(param) && <div class="parameter-default"><span class="meta-label">省略時</span><span class="default-value">{describeDefault(param)}</span></div>}
            {param.min_value?.filter(Boolean).length > 0 && <div><span class="meta-label">最小値</span><span>{param.min_value.filter(Boolean).join(', ')}</span></div>}
            {param.max_value?.filter(Boolean).length > 0 && <div><span class="meta-label">最大値</span><span>{param.max_value.filter(Boolean).join(', ')}</span></div>}
            {param.default?.filter(item => item.environment).map(item => <div class="parameter-default"><span class="meta-label">対象</span><span>{environmentLabel(item.environment, registry)}</span></div>)}
          </div>
          <div class="parameter-description" set:html={param.description} />
          {param.media && <div class="media">
            {param.media.youtube?.map(youtube => <figure>
              {youtube.title && <figcaption>{youtube.title}</figcaption>}
              <div class="video-embed"><iframe src={'https://www.youtube.com/embed/' + youtube.file} title={youtube.title || param.parameter} allowfullscreen /></div>
            </figure>)}
            {param.media.video?.map(video => <figure>
              <figcaption><a href={'/videos/State/' + video.file + '.mp4'}>{video.title}</a></figcaption>
              <video controls><source src={'/videos/State/' + video.file + '.mp4'} type="video/mp4" /></video>
            </figure>)}
            {param.media.image?.map(image => <figure>
              {image.title && <figcaption>{image.title}</figcaption>}
              <img src={'/images/State/' + image.file} alt={image.title} width={image.width} height={image.height} loading="lazy" />
            </figure>)}
          </div>}
          {Array.isArray(param.possible_value?.[0]) ? <div class="possible-value">
            <table>
              <thead><tr>{param.possible_value[0].map(cell => <th scope="col" set:html={cell} />)}</tr></thead>
              <tbody>{param.possible_value.slice(1).map(row => <tr>{row.map(cell => <td set:html={cell} />)}</tr>)}</tbody>
            </table>
          </div> : param.possible_value?.length > 0 && <p class="possible-value"><span class="meta-label">指定できる値</span> {param.possible_value.join(', ')}</p>}
          <Specification value={param} parameterNotes showPolicy={false} />
        </section>
      ))}</div>
    </>}
  </div>
</section>
