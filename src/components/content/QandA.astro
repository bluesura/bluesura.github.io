---
export interface Props {
  qanda?: { q: string; a: string }[];
}
const { qanda } = Astro.props;
---
{qanda && qanda.length > 0 && (
  <section id="QandA">
    <div class="section">
      <h2>Q＆A(よくある質問)</h2>
      <div>
        {qanda.map(item => (
          <>
            <h3>{item.q}</h3>
            <Fragment set:html={item.a} />
            <hr>
          </>
        ))}
      </div>
    </div>
  </section>
)}