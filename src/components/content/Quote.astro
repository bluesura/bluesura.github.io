---
export interface Props {
  quote?: { id?: string; title: string; url: string; source_type?: string }[];
}
const { quote } = Astro.props;
---
{quote && quote.length > 0 && (
  <section id="Quote">
    <div class="section">
      <h2>引用記事</h2>
      <ul>
        {quote.map(item => (
          <li id={item.id ? `source-${item.id}` : undefined}>
            <cite><a href={item.url} target="_blank" rel="external">{item.title}</a></cite>
          </li>
        ))}
      </ul>
    </div>
  </section>
  <hr>
)}
