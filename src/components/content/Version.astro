---
import Notes from './Notes.astro';
import { isPublicNote } from '../../lib/mugen/normalize.mjs';
const { notes = [] } = Astro.props;
const visible = notes.filter(isPublicNote);
---
{visible.length > 0 && <>
  <section id="Version"><div class="section">
    <h2>仕様・バグ・エラー・変更点</h2>
    <Notes notes={visible} />
  </div></section>
  <hr>
</>}
