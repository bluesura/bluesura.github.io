{
  "page": {
    "title": "MUGEN State Controller",
    "subtitle": "AssertSpecial",
    "target": "",
    "category": [
      "特殊処理",
      "透明化やガード不能などの特殊状態の付与"
    ],
    "version": "2002.04.14",
    "update": "2015.11.13",
    "type": "document",
    "level": "3",
    "engine": "mugen",
    "introduced_in": null
