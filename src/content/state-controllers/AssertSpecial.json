  "code_sample": [
    {
      "title": "",
      "description": "200以上300以下または400以上500以下のステートはガード不能になります。",
      "code": [
        "[State , ガード不能]",
        "Type = AssertSpecial",
        "Trigger1 = !Ctrl && ((PrevStateNo = [200,300]) || (PrevStateNo = [400,500]))",
        "Trigger1 = AnimTime < 0",
        "Flag = NoStandGuard",
        "Flag2 = NoCrouchGuard",
        "Flag3 = NoAirGuard"
      ],
      "visibility": "internal"
    },
    {
      "title": "実行者の表示と影を消す",
      "description": "<p>このコントローラーが実行される間、実行者のスプライトと影を非表示にします。<code>AfterImage</code> の表示は別です。</p>",
      "code": [
        "[State 200, Hide sprite and shadow]",
        "Type = AssertSpecial",
        "Trigger1 = 1",
        "Flag = Invisible",
        "Flag2 = NoShadow"
      ]
    }
  ],
