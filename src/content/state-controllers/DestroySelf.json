    {
      "title": "分身バグ対策",
      "description": "ヘルパーがキャラに分身することを防ぎます。[StateDef 0]内に記述して下さい。",
      "code": [
        "[State 0]",
        "Type     = DestroySelf",
        "Trigger1 = IsHelper"
      ],
      "visibility": "internal"
    },
    {
      "title": "アニメーション終了時にHelperを消す",
      "description": "<p>Helperのステートに記述します。アニメーションの終了時に自身を消去します。</p>",
      "code": [
        "[State 200, Remove helper]",
        "Type = DestroySelf",
        "Trigger1 = AnimTime = 0"
      ]
    }
