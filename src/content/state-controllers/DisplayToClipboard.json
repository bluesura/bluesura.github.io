  "documentation": {
    "description": "<p>実行者のクリップボードの内容を消去し、指定したデバッグ用メッセージに置き換えます。クリップボードはデバッグ表示（Ctrl+D）で確認できます。追記したい場合は AppendToClipboard を使用します。</p>",
    "evidence": {
      "status": "confirmed",
      "basis": [
        "official_document"
      ],
      "source_refs": [
        "displayclipboard-local-2002",
        "displayclipboard-local-1.0",
        "displayclipboard-local-1.1"
      ]
    }
  },
