      "value": [
        "落下フラグ"
      ],
      "type": [
        "int"
      ],
      "description": "<p>-1で変更なし。1もしくは-2以下でfall、0だとfallが解除となります。</p>",
      "min_value": [
        ""
      ],
      "max_value": [
        ""
      ],
      "parameter_type": "optional",
