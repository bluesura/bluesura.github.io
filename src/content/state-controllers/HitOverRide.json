  "documentation": {
    "description": "<p>指定した属性の攻撃を受けたとき、通常の被弾処理の代わりに指定ステートへ移行させます。同時に最大8個の HitOverride を有効にできます。</p>",
    "evidence": {
      "status": "confirmed",
      "basis": [
        "official_document"
      ],
      "source_refs": [
        "hitoverride-local-2002",
        "hitoverride-local-1.0",
        "hitoverride-local-1.1"
      ]
    }
  },
  "evidence": {
