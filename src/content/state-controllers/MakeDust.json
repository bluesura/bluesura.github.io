  "documentation": {
    "description": "<p>土煙を表示します。<code>Pos</code> は実行者の軸からの相対位置、<code>Pos2</code> は同時に出す2つ目の土煙の位置、<code>Spacing</code> は表示間隔を指定します。MUGEN 1.0 / 1.1 の公式資料では非推奨で、代わりに <code>Explod</code> の使用を案内しています。</p>",
    "evidence": {
      "status": "confirmed",
      "basis": [
        "official_document"
      ],
      "source_refs": [
        "makedust-local-2002",
        "makedust-local-1.0",
        "makedust-local-1.1"
      ]
    }
  },
