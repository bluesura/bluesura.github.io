  "documentation": {
    "description": "<p>実行者が一時的に受けない攻撃属性を指定します。HitBy と共有する2つの属性スロットの一方へ、指定属性を除いた攻撃属性を設定します。</p>",
    "evidence": {
      "status": "confirmed",
      "basis": [
        "official_document"
      ],
      "source_refs": [
        "nothitby-local-2002",
        "nothitby-local-1.0",
        "nothitby-local-1.1"
      ]
    }
  },
