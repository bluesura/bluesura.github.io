  "documentation": {
    "description": "<p>指定したゲーム tick 数だけゲームを一時停止します。停止中はプレイヤーの更新を止めます。背景の更新と実行者が動ける時間は、<code>PauseBG</code> と <code>MoveTime</code> で制御できます。</p>",
    "evidence": {
      "status": "confirmed",
      "basis": [
        "official_document"
      ],
      "source_refs": [
        "pause-local-2002",
        "pause-local-1.0",
        "pause-local-1.1"
      ]
    }
  },
