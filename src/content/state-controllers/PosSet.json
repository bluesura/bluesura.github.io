      "title": "画面中央に固定",
      "code": [
        "[State ]",
        "Type           = PosSet",
        "Trigger1       = 1",
        "X              = 0",
        "Y              = 120 - ScreenPos Y + Pos Y",
        "IgnoreHitPause = 1"
