  "code_sample": [
    {
      "title": "死の宣告（Declaration of Death）: タイムアップ後（RoundState=3）にTargetLifeAddでP2を0へ固定する",
      "description": "<p>タイムアップで<code>RoundState=3</code>へ遷移した直後は、Win/Lose確定が遅延している間に短い「ライフ変更可能な猶予」が存在します。</p><p>この猶予中に<code>SuperPause</code>で相手の-2等を止め（Pause免疫がない相手ほど効く）、同時に<code>TargetLifeAdd</code>で相手のライフを0へ落とし続けることで、タイムアップの勝敗判定を強制的にひっくり返す目的で使われます。</p><ul><li><b>前提</b>：事前にMarking等でP2を「ターゲット化」しておく（例：HitDefの<code>id=999</code>で捕捉済み）。</li><li><b>注意</b>：<code>RoundState=3</code>中にライフを変更できる時間は短く、環境・相手実装で結果が変わります。</li></ul>",
      "code": [
        ";--------------------------------",
        "; Declaration of Death (timeout)",
        "; 前提: P2をHitDef id=999などでTarget化済み",
        ";--------------------------------",
        "",
        "[State -2, DoD Helper]",
        "type = Helper",
        "trigger1 = !IsHelper",
        "trigger1 = RoundState = 3",
        "trigger1 = Time = 0",
        "helpertype = Normal",
        "name = \"DoD\"",
        "id = 30000",
        "stateno = 30000",
        "pos = 0,0",
        "postype = p1",
        "pausemovetime = 99999999",
        "supermovetime = 99999999",
        "ignorehitpause = 1",
        "",
        "[Statedef 30000]",
        "type = S",
        "movetype = I",
        "physics = N",
        "anim = -1",
        "",
        "; 相手の処理を止める（Pause免疫がない相手ほど-2等が止まる）",
        "[State 30000, HoldSuperPause]",
        "type = SuperPause",
        "trigger1 = Time = 0",
        "time = 60",
        "movetime = 60",
        "darken = 0",
        "anim = -1",
        "sound = -1",
        "unhittable = 0",
        "ignorehitpause = 1",
        "",
        "; 自分を全回復（タイムアップ判定の比較に利用）",
        "[State 30000, FullHeal]",
        "type = LifeSet",
        "trigger1 = RoundState = 3",
        "trigger1 = Time < 60",
        "value = LifeMax",
        "ignorehitpause = 1",
        "",
        "; P2を0へ落とし続ける（ターゲット捕捉が必須）",
        "[State 30000, KillP2]",
        "type = TargetLifeAdd",
        "trigger1 = RoundState = 3",
        "trigger1 = Time < 60",
        "ID = 999",
        "value = -999999",
        "absolute = 1",
        "kill = 1",
        "ignorehitpause = 1",
        "",
        "; 解除（猶予は短いので固定フレームで切る）",
        "[State 30000, End]",
        "type = DestroySelf",
        "trigger1 = Time >= 60",
        "ignorehitpause = 1"
      ]
    },
    {
      "title": "強制死の宣告（Forced Declaration）: 自殺でRoundState=3へ移行して同様の処理を狙う（概略）",
      "description": "<p>通常の「死の宣告」をタイムアップ待ちせずに行う発展形です。</p><ol><li>自分のライフを0にして強制的に<code>RoundState=3</code>へ移行（自殺）。</li><li><code>SuperPause</code>＋<code>TargetLifeAdd</code>で相手のライフを0へ固定し、必要なら自分を全回復。</li></ol><p>完全版では「負けフラグの扱い」を崩すための追加手順（復活のための特殊処理など）まで含みますが、ここではTargetLifeAddを使うコア部分が分かるように最小構成の概略コードのみ示します。</p><ul><li><b>前提</b>：自殺直前に専用Helperを出しておき、KO中でもHelper側が処理を継続できる設計にする。</li></ul>",
      "code": [
        ";--------------------------------",
        "; Forced Declaration (outline)",
        "; 前提: P2をTarget化済み（例: id=999）",
        ";--------------------------------",
        "",
        "; 最後の手段を起動するトリガ（例：コマンドやラウンド条件）",
        "[State -2, Spawn ForcedDoD Helper]",
        "type = Helper",
        "trigger1 = !IsHelper",
        "trigger1 = Command = \"forced_dod\"",
        "helpertype = Normal",
        "name = \"ForcedDoD\"",
        "id = 31000",
        "stateno = 31000",
        "pos = 0,0",
        "postype = p1",
        "pausemovetime = 99999999",
        "supermovetime = 99999999",
        "ignorehitpause = 1",
        "",
        "; 自殺してRoundState=3へ移行させる",
        "[State -2, Commit Suicide]",
        "type = LifeSet",
        "trigger1 = !IsHelper",
        "trigger1 = Command = \"forced_dod\"",
        "value = 0",
        "ignorehitpause = 1",
        "",
        "[Statedef 31000]",
        "type = S",
        "movetype = I",
        "physics = N",
        "anim = -1",
        "",
        "; RoundState=3に入ったら、通常DoDと同様の処理を短時間だけ実行",
        "[State 31000, HoldSuperPause]",
        "type = SuperPause",
        "trigger1 = RoundState = 3",
        "trigger1 = Time = 0",
        "time = 60",
        "movetime = 60",
        "darken = 0",
        "anim = -1",
        "sound = -1",
        "unhittable = 0",
        "ignorehitpause = 1",
        "",
        "[State 31000, FullHeal]",
        "type = LifeSet",
        "trigger1 = RoundState = 3",
        "trigger1 = Time < 60",
        "value = LifeMax",
        "ignorehitpause = 1",
        "",
        "[State 31000, KillP2]",
        "type = TargetLifeAdd",
        "trigger1 = RoundState = 3",
        "trigger1 = Time < 60",
        "ID = 999",
        "value = -999999",
        "absolute = 1",
        "kill = 1",
        "ignorehitpause = 1",
        "",
        "[State 31000, End]",
        "type = DestroySelf",
        "trigger1 = Time >= 60",
        "ignorehitpause = 1"
      ]
    }
  ],
