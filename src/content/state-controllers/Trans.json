  "documentation": {
    "description": "<p>実行者のアニメーションに設定された透過方法を現在のゲーム tick の間だけ上書きします。<code>Trans</code> で透過型を指定し、必要に応じて <code>Alpha</code> で加算透過の強さを調整します。</p>",
    "evidence": {
      "status": "confirmed",
      "basis": [
        "official_document"
      ],
      "source_refs": [
        "trans-local-2002",
        "trans-local-1.0",
        "trans-local-1.1"
      ]
    }
  },
