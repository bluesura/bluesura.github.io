  "code_sample": [
    {
      "title": "攻撃を受けたときのY方向への吹き飛び速度が-5.5未満だったときのトリガー。",
      "code": [
        "Trigger1 = GetHitVar(yvel) < -5.5"
      ]
    },
    {
      "title": "被弾処理で上向きの速度を判定する",
      "description": "<p>処理対象をMoveTypeで確認し、与えられたY速度を比較する条件部分です。現在のVel Yを調べる式ではありません。</p>",
      "code": [
        "Trigger1 = MoveType = H",
        "Trigger1 = GetHitVar(yvel) < -5.5"
      ]
    },
    {
      "title": "被弾の硬直終了を負数で判定する",
      "description": "<p>既存の被弾処理で使う条件部分です。0を終了に含めず、HitOverに対応する負数条件を使います。</p>",
      "code": [
        "Trigger1 = MoveType = H",
        "Trigger1 = GetHitVar(hittime) < 0"
      ]
    },
    {
      "title": "TargetBindによる拘束を参照する",
      "description": "<p>被弾処理から拘束の有無を読む条件部分です。StateNoだけで拘束を推定しません。</p>",
      "code": [
        "Trigger1 = MoveType = H",
        "Trigger1 = GetHitVar(isbound)"
      ]
    }
  ],
