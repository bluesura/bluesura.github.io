          "通常投げ（Normal Throw）"
        ],
        [
          "<code>SA</code>",
          "必殺攻撃（Special Attack）"
        ],
        [
          "<code>ST</code>",
          "必殺投げ（Special Throw）"
        ],
        [
          "<code>HA</code>",
          "超必殺攻撃（Hyper/Super Attack）"
        ],
        [
          "<code>HT</code>",
          "超必殺投げ（Hyper/Super Throw）"
        ]
      ]
    }
  ],
  "code_sample": [
    {
      "title": "空中の超必殺攻撃だけを検出する",
      "description": "<p>現在アクティブな <code>HitDef</code> が「空中(<code>A</code>)」かつ「超必殺攻撃(<code>HA</code>)」のときに真になります。</p>",
      "code": [
        "trigger1 = HitDefAttr = A, HA"
      ]
    },
    {
      "title": "立ち/しゃがみ状態で通常攻撃または必殺攻撃を検出する",
      "description": "<p><code>value1</code> に <code>SC</code> を指定し、<code>value2</code> に <code>NA</code>(通常攻撃) と <code>SA</code>(必殺攻撃) を列挙します。</p>",
      "code": [
        "trigger1 = HitDefAttr = SC, NA, SA"
      ]
    },
