  "trigger": "HitOver",
  "summary": "<p>攻撃を受けた場合のHitTimeが0になったかどうかを返します。</p>",
  "syntax": [
    "HitOver"
  ],
  "description": "攻撃を受けた場合のHitTimeが0になったかどうかを返します。<br>攻撃を受けた場合のHitTimeが0になったとき、1を返します。<br>共通のやられは、このトリガーにより通常ステートに移されています。やられステートをカスタマイズするときなどに使用します。",
  "code_sample": [
    {
      "title": "プレイヤーのやられ状態が終了したときのトリガー",
      "code": [
        "Trigger1 = HitOver = 1"
      ]
    },
    {
      "title": "被弾状態でのけぞり時間の終了を判定",
      "code": [
        "Trigger1 = MoveType = H",
        "Trigger1 = HitOver = 1"
      ]
    }
  ],
