  "category": "trigger",
  "trigger": "ID",
  "summary": "<p>プレイヤーのIDを返します。</p>",
  "syntax": [
    "ID"
  ],
  "description": "プレイヤーのIDを返します。<br>このIDは、helperを含むプレイヤーが発生すると、自動で割り付けられ、その試合中は変更できません。自分で指定することもできません。<br>\"playerID\"リダイレクトキーワードに使用するため、敵のIDを取得するのが主な使用方法です。<br>戻り値の型: int",
  "code_sample": [
    {
      "title": "プレイヤーのID番号をvalueに代入します。",
      "code": [
        "value = ID"
      ]
    },
    {
      "title": "プレイヤーに最も近い敵のID番号をvalueに代入します。",
      "code": [
        "value = EnemyNear, ID"
      ]
    },
    {
      "title": "最も近い敵の一意IDをvar(0)へ保存する",
      "description": "<p>var(0)はこの例の保存先です。キャラクターの既存用途に合わせて番号を選び、存在確認にも同じ変数を使ってください。</p>",
      "code": [
        "[State 0, Save opponent ID]",
        "Type = VarSet",
        "Trigger1 = NumEnemy > 0",
        "v = 0",
        "value = EnemyNear, ID"
      ]
    }
  ],
