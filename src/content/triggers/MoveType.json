  "category": "trigger",
  "trigger": "MoveType",
  "summary": "<p>現在のMoveTypeを判定し、真偽を返します。</p>",
  "syntax": [
    "MoveType = 動作型",
    "MoveType != 動作型"
  ],
  "description": "現在のMoveTypeを判定し、真偽を返します。<br>動作型には、A, I, Hのいずれかを指定します。順に、攻撃、待機、くらいを意味します。<br>戻り値の型: boolean int (1 or 0)",
  "code_sample": [
    {
      "title": "プレイヤーが攻撃を受けている状態でないときのトリガー。",
      "code": [
        "Trigger1 = movetype != H"
      ]
    },
    {
      "title": "攻撃でもくらいでもない行動状態か調べる",
      "description": "<p>Iとの一致を判定します。立ち・しゃがみ・空中の体勢はこの条件だけでは限定しません。</p>",
      "code": [
        "Trigger1 = MoveType = I"
      ]
    }
  ],
