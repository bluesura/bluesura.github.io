    "category": "trigger",
    "trigger": "Name",
    "summary": "<p>defファイルで設定してあるnameを判定し、真偽を返します。</p>",
    "syntax": [
        "Name = \"名前\"",
        "Name != \"名前\""
    ],
    "description": "defファイルで設定してあるnameを判定し、真偽を返します。<br>画面に表示されるキャラクター名とは、必ずしも一致しません。<br>\"名前\"には、判定する名前を\"\"で括ってstringで指定します。<br>戻り値の型: boolean int (1 or 0)",
    "code_sample": [
        {
            "title": "プレイヤーの名称が「Kumquat（キンカン）」さんの場合のトリガー。",
            "code": [
                "Trigger1 = Name = \"Kumquat\""
            ]
        }
    ],
