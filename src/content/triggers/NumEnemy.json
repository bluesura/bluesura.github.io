  "trigger": "NumEnemy",
  "summary": "<p>現在の敵の数を返します。</p>",
  "syntax": [
    "NumEnemy"
  ],
  "description": "現在の敵の数を返します。<br>ヘルパーは数に含まれません。<br>戻り値の型: int",
  "code_sample": [
    {
      "title": "敵が2人いて、2番目に近い敵の名前がSquashだったときのトリガー",
      "code": [
        "Trigger1 = NumEnemy = 2",
        "Trigger1 = EnemyNear(1),Name = \"Squash\""
      ]
    },
    {
      "title": "2番目に近い敵のライフを調べる",
      "description": "<p>先の人数条件を満たしたときだけ、2番目の敵を参照します。</p>",
      "code": [
        "Trigger1 = NumEnemy >= 2",
        "Trigger1 = EnemyNear(1),Life < 200"
      ]
    }
  ],
