  "category": "trigger",
  "trigger": "NumExplod",
  "summary": "<p>出現しているExplodの数を返します。</p>",
  "syntax": [
    "NumExplod",
    "NumExplod(ExplodのID)"
  ],
  "description": "出現しているExplodの数を返します。<br>引数にID番号を指定した場合、そのID番号のExplodの数を返します。<br>IDには、-1以上の整数を指定します。-1の場合、省略時と同じ扱いになります。<br>戻り値の型: int",
  "associated_state": [
    "Explod"
  ],
  "code_sample": [
    {
      "title": "プレイヤーのexplodが4つ以上出現している場合のトリガー",
      "code": [
        "Trigger1 = NumExplod >= 4"
      ]
    },
    {
      "title": "プレイヤーのID1234のexplodが4つ以上出現している場合のトリガー",
      "code": [
        "Trigger1 = NumExplod(1234) >= 4"
      ]
    },
    {
      "title": "指定IDのExplodがないことを確認する",
      "code": [
        "Trigger1 = NumExplod(1234) = 0"
      ]
    }
  ],
