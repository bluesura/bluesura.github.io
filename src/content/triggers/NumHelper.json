    "category": "trigger",
    "trigger": "NumHelper",
    "summary": "<p>プレイヤーが出現させているhelperの数を返します。</p>",
    "syntax": [
        "NumHelper",
        "NumHelper(HelperのID)"
    ],
    "description": "プレイヤーが出現させているhelperの数を返します。<br>引数にID番号を指定した場合、そのID番号のhelperの数を返します。<br>IDには、0以上の整数を指定します。0以下の数を指定した場合、省略時と同じ扱いになります。<br>戻り値の型: int",
    "associated_state": [
        "Helper"
    ],
    "code_sample": [
        {
            "title": "プレイヤーのヘルパー数が2つ未満の場合のトリガー",
            "code": [
                "Trigger1 = NumHelper < 2"
            ]
        },
        {
            "title": "プレイヤーのID1234のヘルパー数が2つ未満の場合のトリガー",
            "code": [
                "Trigger1 = NumHelper(1234) < 2"
            ]
        }
    ],
