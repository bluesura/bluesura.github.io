  "category": "trigger",
  "trigger": "NumProj",
  "summary": "<p>プレイヤーが出現させているProjectileの数を返します。</p>",
  "syntax": [
    "NumProj"
  ],
  "description": "プレイヤーが出現させているProjectileの数を返します。<br>飛び道具の数を制限したい場合に使用します。<br>ID指定したい場合は、NumProjIDを使いましょう。<br>戻り値の型: int",
  "associated_state": [
    "Projectile"
  ],
  "code_sample": [
    {
      "title": "プレイヤーの飛び道具が出現していない場合のトリガー",
      "code": [
        "Trigger1 = NumProj = 0"
      ]
    },
    {
      "title": "Projectileが1個以上存在するか調べる",
      "code": [
        "Trigger1 = NumProj > 0"
      ]
    },
    {
      "title": "Helperから本体が所有するProjectileの総数を調べる",
      "description": "<p>Helper内の条件として使う例です。Rootに参照を変更し、本体が所有するProjectileがあるか調べます。</p>",
      "code": [
        "Trigger1 = Root, NumProj > 0"
      ]
    }
  ],
