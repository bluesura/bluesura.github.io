  "category": "trigger",
  "trigger": "NumProjID",
  "summary": "<p>プレイヤーの特定IDのProjectile数を返します。</p>",
  "syntax": [
    "NumProjID(ProjectileのID)"
  ],
  "description": "プレイヤーの特定IDのProjectile数を返します。<br>コマンド条件で飛び道具の数を制限したい場合などに使用します。<br>引数には、数えたいProjectileのIDを、intで指定します。引数に負数を指定した場合、IDは0とみなされます。<br>戻り値の型: int",
  "associated_state": [
    "Projectile"
  ],
  "code_sample": [
    {
      "title": "プレイヤーが放出したID1234の飛び道具が1つだけ存在している場合のトリガー",
      "code": [
        "Trigger1 = NumProjID(1234) = 1"
      ]
    },
    {
      "title": "ProjID 1234のProjectileが存在しないことを調べる",
      "code": [
        "Trigger1 = NumProjID(1234) = 0"
      ]
    },
    {
      "title": "Helperから本体が所有する指定ProjIDの数を調べる",
      "description": "<p>Helper内の条件として使う例です。Rootに参照を変更し、ProjID 1234のProjectileが存在するか調べます。</p>",
      "code": [
        "Trigger1 = Root, NumProjID(1234) > 0"
      ]
    }
  ],
