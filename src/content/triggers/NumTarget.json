    "category": "trigger",
    "trigger": "NumTarget",
    "summary": "<p>プレイヤーのターゲットの数を返します。</p>",
    "syntax": [
        "NumTarget",
        "NumTarget(ID)"
    ],
    "description": "プレイヤーのターゲットの数を返します。<br>引数にID番号を指定した場合、そのID番号のターゲット数を返します。<br>IDに-1以下を指定した場合、省略時と同様に扱われます。引数には、数えたいターゲットのヒットIDを指定します。<br>戻り値の型: int",
    "code_sample": [
        {
            "title": "ターゲットが2体以上のときのトリガー",
            "code": [
                "Trigger1 = NumTarget >= 2"
            ]
        },
        {
            "title": "ID1234のターゲットが2体以上のときのトリガー",
            "code": [
                "Trigger1 = NumTarget(1234) >= 2"
            ]
        }
    ],
