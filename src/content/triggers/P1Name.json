  "title": "P1Name",
  "category": "trigger",
  "trigger": "P1Name",
  "description": "<p><code>P1Name</code> は <code>Name</code> の別書式（エイリアス）です。評価対象（通常は実行者＝P1）の <code>.def</code> 内部名 <code>name</code> を比較し、一致すれば <code>1</code>、一致しなければ <code>0</code> を返します。</p><p>本トリガーは「比較式として使うトリガー」であり、単体で値を返す形式ではなく、<code>=</code> / <code>!=</code> の比較としてのみ記述できます。</p>",
  "images": [
      {
      "src": "mugen_name_authorname_logic_flow.png",
      "width": "640",
      "height": "480",
      "alt": "MUGENのAuthorNameおよびName/PxNameの判定仕様図。P1〜P4の各対象に対し、.defファイル内の記述とスクリプト記述を比較演算子(=, !=)で照合し、真(1)か偽(0)を返すフローを解説しています。"
      }
  ],
  "syntax": [
    "P1Name = \"名前\"",
    "P1Name != \"名前\""
  ],
  "associated_trigger": [
    "Name",
    "AuthorName",
    "P2Name",
    "P3Name",
    "P4Name"
  ],
  "code_sample": [
    {
      "title": "P1Name（= Name）で内部名を判定する",
      "description": "<p><code>P1Name</code> は <code>Name</code> と同義です（可読性や統一目的で使い分けるケースがあります）。</p>",
      "code": [
        "[State -2, P1NameGate]",
        "Type = VarSet",
        "Trigger1 = P1Name = \"Kumquat\"",
        "Var = 2",
        "Value = 1"
      ]
    }
  ],
