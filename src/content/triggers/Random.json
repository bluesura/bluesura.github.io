  "title": "Random",
  "category": "trigger",
  "trigger": "Random",
  "description": "<p>0〜999（両端含む）の乱数（整数）を返します。</p>",
  "syntax": [
    "Random"
  ],
  "code_sample": [
    {
      "title": "25%の確率判定",
      "description": "<p><code>0〜249</code> の250通りを当たりにすることで、約25%の確率にします。</p>",
      "code": [
        "Trigger1 = Random <= 249"
      ]
    },
    {
      "title": "同じフレームで同じ乱数を使い回す",
      "description": "<p><code>Random</code> は参照のたびに値が変わるため、先に <code>Var</code> に保存してから参照します。</p>",
      "code": [
        "[State -2, RandomCache]",
        "Type = VarSet",
        "Trigger1 = 1",
        "Var(10) = Random"
      ],
      "visibility": "internal"
    },
    {
      "title": "任意の範囲へ変換する",
      "description": "<p><code>%</code> 演算で範囲を圧縮します（例: 0〜99）。</p>",
      "code": [
        "value = Random % 100"
      ]
    }
  ],
