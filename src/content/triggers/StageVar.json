  "title": "StageVar",
  "category": "trigger",
  "trigger": "StageVar",
  "description": "<p>ステージ定義（<code>.def</code>）の <code>[Info]</code> グループにある文字列を比較し、真偽値（<code>1</code>/<code>0</code>）を返します。</p><p>このトリガーは「条件型」で、単体では値を返す関数ではありません。<code>StageVar(…)</code> の直後に <code>=</code> または <code>!=</code> を書き、ダブルクォートで囲んだ文字列と比較します。</p>",
  "syntax": [
    "StageVar(Info.Name) = \"ステージ名\"",
    "StageVar(Info.DisplayName) = \"表示名\"",
    "StageVar(Info.Author) = \"作者名\"",
    "StageVar(Info.Name) != \"ステージ名\"",
    "StageVar(Info.DisplayName) != \"表示名\"",
    "StageVar(Info.Author) != \"作者名\""
  ],
  "parameter": [
    {
      "parameter": "param_name",
      "type": [
        "string"
      ],
      "description": "<p>比較対象にするステージ <code>[Info]</code> パラメータ名。</p>",
      "parameter_type": "required",
      "possible_value": [
        [
          "値",
          "説明"
        ],
        [
          "Info.Name",
          "<code>[Info]</code> の <code>name</code> を比較します。"
        ],
        [
          "Info.DisplayName",
          "<code>[Info]</code> の <code>displayname</code> を比較します。"
        ],
        [
          "Info.Author",
          "<code>[Info]</code> の <code>author</code> を比較します。"
        ]
      ]
    },
    {
      "parameter": "[oper]",
      "type": [
        "string"
      ],
      "description": "<p>使用できる演算子は <code>=</code> と <code>!=</code> のみです。</p>",
      "parameter_type": "required",
      "possible_value": [
        [
          "値",
          "説明"
        ],
        [
          "=",
          "等しい（文字列比較）"
        ],
        [
          "!=",
          "等しくない（文字列比較）"
        ]
      ]
    },
    {
      "parameter": "\"string\"",
      "type": [
        "string"
      ],
      "description": "<p>比較する文字列。必ずダブルクォートで囲みます。</p>",
      "parameter_type": "required"
    }
  ],
  "version": [
    {
      "no": "MUGEN 1.0 RC8",
      "content": "<p><code>StageVar</code> トリガーが追加されました（ステージ名・作者などの基本チェック）。</p>"
    }
  ],
  "code_sample": [
    {
      "title": "特定ステージでのみ処理する",
      "description": "<p>ステージ名（<code>[Info] name</code>）で分岐します。</p>",
      "code": [
        "Trigger1 = StageVar(Info.Name) = \"kfm\""
