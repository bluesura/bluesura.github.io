  "trigger": "StateType",
  "summary": "<p>現在のStateTypeを判定し、真偽を返します。</p>",
  "syntax": [
    "StateType = S",
    "StateType = C",
    "StateType = A",
    "StateType = L",
    "StateType != S",
    "StateType != C",
    "StateType != A",
    "StateType != L"
  ],
  "description": "現在のStateTypeを判定し、真偽を返します。<br>cmdファイルでの条件指定に有効です。<br>state_typeには、S, C, A(順に立ち、しゃがみ、空中を表す)の文字のうち、いずれかを指定します。<br>戻り値の型: boolean int (1 or 0)",
  "code_sample": [
    {
      "title": "StateTypeがA（空中）でない場合のトリガー",
      "code": [
        "Trigger1 = StateType != A"
      ]
    },
    {
      "title": "倒れ状態か調べる",
      "description": "<p>体勢Lとの一致を判定します。</p>",
      "code": [
        "Trigger1 = StateType = L"
      ]
    }
  ],
