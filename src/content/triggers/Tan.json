  "title": "Tan",
  "category": "trigger",
  "trigger": "Tan",
  "description": "<p><code>Tan</code> は、角度（ラジアン）の正接(浮動小数点数)を返します。</p><p>入力が度の場合は、<code>度 * PI / 180</code> でラジアンに変換してから渡します。</p><p><code>Tan</code> は <code>PI/2</code> 付近で値が急激に大きくなるため、角度の扱い・条件分岐・分母に使う箇所では極端な値になりうる点に注意してください。</p>",
  "images": [
    {
      "src": "mugen-trigonometry-functions-guide.png",
      "width": "640",
      "height": "480",
      "alt": "MUGENにおける三角関数の仕様まとめ。Sin, Cos, Tanの入力値と出力の関係、度数からラジアンへの変換式、Atanによる角度計算の図解。"
    }
  ],
  "syntax": [
    "Tan(Radian)"
  ],
  "parameter": [
    {
      "parameter": "Radian",
      "type": [
        "float"
      ],
      "description": "<p>ラジアン単位の角度を指定します。</p>",
      "parameter_type": "required"
    }
  ],
  "associated_trigger": [
    "Sin",
    "Cos",
    "Atan",
    "PI",
    "Asin",
    "Acos"
  ],
  "version": [
    {
      "no": "エラー条件",
      "content": "<p><code>Radian</code> が評価不能値（bottom）に評価された場合、戻り値も bottom になります。</p>"
    }
  ],
  "code_sample": [
    {
      "title": "Tan(PI/4) は 1",
      "description": "<p><code>PI/4</code> ラジアン（45度）の正接は <code>1</code> です。</p>",
      "code": [
        "Value = Tan(PI/4)"
      ]
    },
    {
      "title": "度で持っている角度から傾きを作る",
      "description": "<p>角度が度で管理されている場合は、<code>PI/180</code> を掛けてラジアンにしてから <code>Tan</code> に渡します。</p>",
      "code": [
        "Value = Tan(角度 * PI / 180.0)"
      ],
      "visibility": "internal"
    }
  ],
