  "category": "trigger",
  "trigger": "TimeMod",
  "summary": "<p>Timeの剰余計算を比較した結果を返します。</p>",
  "syntax": [
    "TimeMod = 除数・正の整数, 剰余・整数",
    "TimeMod != 除数・正の整数, 剰余・整数",
    "TimeMod < 除数・正の整数, 剰余・整数",
    "TimeMod > 除数・正の整数, 剰余・整数",
    "TimeMod <= 除数・正の整数, 剰余・整数",
    "TimeMod >= 除数・正の整数, 剰余・整数"
  ],
  "description": "Timeの剰余計算を比較した結果を返します。<br>ステート時間を第1指定値で割った余りが第2指定値と符号の条件を満たしている場合は1、満たしていない場合は0を返します。<br>%も割り算の余りを返す符号なので、代用可能で、このトリガーは使う必要がありません。",
  "version": [
    {
      "no": "エラー",
      "content": "除数を0にするとSFalseを返します。"
    }
  ],
  "code_sample": [
    {
      "title": "ステートの経過時間が 3, 7, 11, 15, ...のときのトリガー",
      "code": [
        "Trigger1 = TimeMod = 4, 3"
      ]
    }
  ],
