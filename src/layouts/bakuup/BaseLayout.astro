---
// src/layouts/BaseLayout.astro
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro'; // 補足で作成
import Head from '../components/Head.astro';     // 補足で作成

export interface Props {
  title: string;
  description: string;
  url: string;
}

const siteTitle = "Name = すら";

const { title, description, url } = Astro.props;
---
<!DOCTYPE html>
<html lang="ja-JP" prefix="og: http://ogp.me/ns# fb: http://www.facebook.com/2008/fbml">
<head>
  <Head title={siteTitle} description={description} url={url} />
  <!-- Google Tag Manager -->
  <script is:inline>
    (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
    new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
    j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
    '//www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
    })(window,document,'script','dataLayer','GTM-MMQSZM');
  </script>
</head>
<body>
  <noscript><iframe src="//www.googletagmanager.com/ns.html?id=GTM-MMQSZM"
  height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>

  <div id="container">
    <div id="container-inner">
      <Header siteName={siteTitle} />
      <div id="content" class="hfeed">
        <div id="content-inner">
          <div id="wrapper">
            <!-- 各ページの内容がここに挿入されます -->
            <slot />
          </div>
        </div>
      </div>
    </div>
  </div>

  <Footer />
</body>
</html>