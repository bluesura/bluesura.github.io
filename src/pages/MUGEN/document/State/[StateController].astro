---
import { getCollection } from 'astro:content';
import ArticleLayout from '../../../../layouts/ArticleLayout.astro';
import { effectivePageCategory } from '../../../../lib/mugen/normalize.mjs';

export async function getStaticPaths() {
  const allEntries = await getCollection('state-controllers');
  return allEntries.map(entry => ({
    params: { StateController: entry.id }, // .idから.slugに戻すのが一般的
    props: { entry },
  }));
}
const { entry } = Astro.props;
const content = entry.data;
const pageCategory = effectivePageCategory(entry.data) || 'MUGEN State Controller';


---
<ArticleLayout entry={entry} pageCategory={pageCategory} />
