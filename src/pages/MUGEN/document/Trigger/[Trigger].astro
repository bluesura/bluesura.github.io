---
import { getCollection, getEntry } from 'astro:content';
import ArticleLayout from '../../../../layouts/ArticleLayout.astro';
import { effectivePageCategory } from '../../../../lib/mugen/normalize.mjs';

export async function getStaticPaths() {
  const allTriggerEntries = await getCollection('triggers');
  return allTriggerEntries.map(entry => ({
    params: { Trigger: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const content = entry.data;
const pageCategory = effectivePageCategory(entry.data) || 'MUGEN Trigger Reference';


if (!entry) {
  return Astro.redirect('/404');
}
---
<ArticleLayout entry={entry} pageCategory={pageCategory} />
