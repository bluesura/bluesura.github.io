---
// src/pages/MUGEN/document/Trigger/index.astro

import { getCollection } from 'astro:content';
import BaseLayout from '../../../../layouts/BaseLayout.astro';

// 1. Triggerの全データを取得
const allTriggers = await getCollection('triggers');

// 2. trigger名でアルファベット順にソート
allTriggers.sort((a, b) => a.data.trigger.localeCompare(b.data.trigger));

// 3. ページ全体の情報を定義
const pageTitle = "Trigger Reference";
const description = "MUGENのTrigger（トリガー）の一覧です。";
---
<BaseLayout
  pageTitle={pageTitle}
  description={description}
  url={Astro.url}
>
  <div id="main-inner">
    <article class="entry hentry mugen-document">
      <header class="entry-header">
        <div class="entry-title">
          <h1>トリガー一覧</h1>
        </div>
      </header>

      <div class="entry-content">
        {allTriggers.map(entry => {
          const content = entry.data;
          return (
            <div class="section">
              <h2><a href={`/MUGEN/document/Trigger/${entry.id}.html`}>{content.trigger}</a></h2>
              <div set:html={content.description}></div>
              {content.syntax && (
                <div class="code" contenteditable="true">
                  <ul>
                    {content.syntax.map((line: string) => <li set:html={line} />)}
                  </ul>
                </div>
              )}
            </div>
          )
        })}
      </div>
    </article>
  </div>
</BaseLayout>
