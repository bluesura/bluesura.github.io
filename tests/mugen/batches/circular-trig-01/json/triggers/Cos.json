  "title": "Cos",
  "category": "trigger",
  "trigger": "Cos",
  "description": "<p><code>Cos</code> は、角度（ラジアン）の余弦(浮動小数点数)を返します。</p><p>入力が度の場合は、<code>度 * PI / 180</code> でラジアンに変換してから渡します。</p><p><code>Sin</code> と同様に、周期運動（揺れ・点滅・軌道）などの数式表現でよく使われます。</p>",
  "images": [
      {
      "src": "mugen-trigonometry-functions-guide.png",
      "width": "640",
      "height": "480",
      "alt": "MUGENにおける三角関数の仕様まとめ。Sin, Cos, Tanの入力値と出力の関係、度数からラジアンへの変換式、Atanによる角度計算の図解。"
      }
  ],
  "syntax": [
    "Cos(Radian)"
  ],
  "parameter": [
    {
      "parameter": "Radian",
      "type": [
        "float"
      ],
      "description": "<p>ラジアン単位の角度を指定します。</p>",
      "parameter_type": "required"
    }
  ],
  "associated_trigger": [
    "Sin",
    "Tan",
    "PI",
    "Asin",
    "Acos",
    "Atan"
  ],
  "version": [
    {
      "no": "エラー条件",
      "content": "<p><code>Radian</code> が評価不能値（bottom）に評価された場合、戻り値も bottom になります。</p>"
    }
  ],
  "code_sample": [
    {
      "title": "Cos(0) は 1",
      "description": "<p><code>0</code> ラジアン（0度）の余弦は <code>1</code> です。</p>",
      "code": [
        "Value = Cos(0)"
      ]
    }
  ],
