    "type": "document",
    "level": "3"
  },
  "title": "Sin",
  "category": "trigger",
  "trigger": "Sin",
  "description": "<p><code>Sin</code> は、角度（ラジアン）の正弦(浮動小数点数)を返します。</p><p>入力が度の場合は、<code>度 * PI / 180</code> でラジアンに変換してから渡します。</p><p>周期運動（揺れ・点滅・軌道）など、フレーム経過に応じて値を波形変化させたい用途でよく使われます。</p>",
    "images": [
        {
        "src": "mugen-trigonometry-functions-guide.png",
        "width": "640",
        "height": "480",
        "alt": "MUGENにおける三角関数の仕様まとめ。Sin, Cos, Tanの入力値と出力の関係、度数からラジアンへの変換式、Atanによる角度計算の図解。"
        }
    ],
  "syntax": [
    "Sin(Radian)"
  ],
  "parameter": [
    {
      "parameter": "Radian",
      "type": [
        "float"
      ],
      "description": "<p>ラジアン単位の角度を指定します。</p>",
      "parameter_type": "required"
    }
  ],
  "associated_trigger": [
    "Cos",
    "Tan",
    "PI",
    "Asin",
    "Acos",
    "Atan"
  ],
  "version": [
    {
      "no": "エラー条件",
      "content": "<p><code>Radian</code> が評価不能値（bottom）に評価された場合、戻り値も bottom になります。</p>"
    }
  ],
  "code_sample": [
    {
      "title": "Sin(PI/2) は 1",
      "description": "<p><code>PI/2</code> ラジアン（90度）の正弦は <code>1</code> です。</p>",
      "code": [
        "Value = Sin(PI/2)"
      ]
    },
    {
      "title": "Sin/Cosで円運動（擬似）を作る",
      "description": "<p><code>Sin</code> と <code>Cos</code> を組み合わせ、角度 <code>θ</code> をフレームで進めて円運動のベクトルを作ります（半径は <code>Radius</code>）。</p>",
      "code": [
        "[State -2, OrbitVel]",
        "Type = VelSet",
        "Trigger1 = 1",
        "X = Cos(PI * 2.0 / 60.0 * Time) * ラディウス",
        "Y = -Sin(PI * 2.0 / 60.0 * Time) * ラディウス"
      ]
    }
  ],
