  "title": "Abs",
  "category": "trigger",
  "trigger": "Abs",
  "description": "<p><code>exprn</code> の絶対値を返します。</p><p>戻り値の型は引数の評価結果に従います（整数なら整数、浮動小数点なら浮動小数点）。</p>",
  "syntax": [
    "Abs(exprn)"
  ],
  "associated_trigger": [
    "Floor",
    "Ceil"
  ],
  "version": [
    {
      "no": "2002.04.14",
      "content": "<p><code>exprn</code> が <code>SFalse</code> の場合は <code>SFalse</code> を返します。</p>"
    },
    {
      "no": "MUGEN 1.0/1.1",
      "content": "<p>式が評価不能の場合は <code>bottom</code> を返します。</p>"
    }
  ],
  "parameter": [
    {
      "parameter": "exprn",
      "type": [
        "定数や変数、他のトリガー、関数、演算子"
      ],
      "description": "<p>絶対値を計算したい式を指定します（整数も指定可能）。</p><p>戻り値は <code>exprn</code> の評価結果と同じ型になります。</p>",
      "parameter_type": "required"
    }
  ],
  "code_sample": [
    {
      "title": "左右方向を無視して距離判定（符号を消す）",
      "description": "<p><code>P2Dist X</code> の符号（左右）を無視して距離として扱いたい場合に使います。</p>",
      "code": [
        "Trigger1 = Abs(P2Dist X) < 40"
      ]
    },
    {
      "title": "三角波っぽい値を作る（点滅・振動などの素材）",
      "description": "<p>0〜15〜0…のような往復パターンを作り、周期的な演出に使います（<code>GameTime</code> はゲーム開始からの経過フレーム）。</p>",
      "code": [
        "Var(0) = Abs(15 - (GameTime % 30))"
      ]
    }
  ],
