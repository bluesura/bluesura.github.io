  "title": "Ceil",
  "category": "trigger",
  "trigger": "Ceil",
  "description": "<p>天井関数（Ceil）です。引数以上の最小の整数を返します。</p><p>負数のときも数学的な <code>Ceil</code> として動作します（例: <code>Ceil(-2.3) = -2</code>）。</p>",
  "syntax": [
    "Ceil(exprn)"
  ],
  "associated_trigger": [
    "Floor"
  ],
  "version": [
    {
      "no": "2002.04.14系（旧ドキュメント表記）",
      "content": "<p><code>exprn</code> が <code>SFalse</code> の場合は <code>SFalse</code> を返します。</p>"
    },
    {
      "no": "MUGEN 1.0/1.1",
      "content": "<p><code>exprn</code> が <code>bottom</code> の場合は <code>bottom</code> を返します。</p>"
    }
  ],
  "parameter": [
    {
      "parameter": "exprn",
      "type": [
        "float"
      ],
      "description": "<p>Ceilを計算する式を指定します（整数も指定可能）。</p>",
      "parameter_type": "required"
    }
  ],
  "code_sample": [
    {
      "title": "小数を整数へ（正数）",
      "code": [
        "; 6",
        "value = Ceil(5.5)"
      ]
    },
    {
      "title": "小数を整数へ（負数）",
      "description": "<p>負数はより大きい整数側へ丸められます。</p>",
      "code": [
        "; -2",
        "value = Ceil(-2.3)"
      ]
    }
  ],
