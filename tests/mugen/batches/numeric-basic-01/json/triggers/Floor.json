{
  "page": {
    "title": "MUGEN Trigger",
    "subtitle": "Floor",
    "category": [
      "数値計算",
      "小数点以下の切り捨て"
    ],
    "version": "2002.04.14",
    "update": "2026.01.14",
    "type": "document",
    "level": "3"
  },
  "title": "Floor",
  "category": "trigger",
  "trigger": "Floor",
  "description": "<p>床関数（Floor）です。引数以下の最大の整数を返します。</p><p>負数のときも「0方向への丸め」ではなく、数学的な <code>Floor</code> として動作します（例: <code>Floor(-2.3) = -3</code>）。</p>",
  "syntax": [
    "Floor(exprn)"
  ],
  "associated_trigger": [
    "Ceil"
  ],
  "version": [
    {
      "no": "2002.04.14系（旧ドキュメント表記）",
      "content": "<p><code>exprn</code> が <code>SFalse</code> の場合は <code>SFalse</code> を返します。</p>"
    },
    {
      "no": "MUGEN 1.0/1.1",
      "content": "<p><code>exprn</code> が <code>bottom</code> の場合は <code>bottom</code> を返します。</p>"
    }
  ],
  "parameter": [
    {
      "parameter": "exprn",
      "type": [
        "float"
      ],
      "description": "<p>Floorを計算する式を指定します（整数も指定可能）。</p>",
      "parameter_type": "required"
    }
  ],
  "code_sample": [
    {
      "title": "小数を整数へ（正数）",
      "code": [
        "; 5",
        "value = Floor(5.5)"
      ]
    },
    {
      "title": "小数を整数へ（負数）",
      "description": "<p>負数はより小さい整数側へ丸められます。</p>",
      "code": [
        "; -3",
        "value = Floor(-2.3)"
      ]
    }
  ],
